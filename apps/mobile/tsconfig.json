{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "moduleResolution": "bundler",
    "paths": {
      "@daygym/config": ["../../packages/config/src/index.ts"],
      "@daygym/design-tokens": ["../../packages/design-tokens/src/index.ts"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "config/**/*.ts",
    "config/**/*.json",
    "lib/**/*.ts",
    "app.config.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
