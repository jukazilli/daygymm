{
  "name": "@daygym/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "pnpm build:workspace-deps && expo export --platform all --output-dir dist",
    "build:workspace-deps": "pnpm --filter @daygym/contracts build && pnpm --filter @daygym/training-runtime build",
    "dev": "pnpm --filter @daygym/contracts build && pnpm --filter @daygym/training-runtime build && expo start --dev-client",
    "postinstall": "pnpm build:workspace-deps",
    "lint": "eslint app lib config app.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@daygym/config": "workspace:*",
    "@daygym/contracts": "workspace:*",
    "@daygym/design-tokens": "workspace:*",
    "@daygym/training-runtime": "workspace:*",
    "@expo-google-fonts/nunito": "0.4.2",
    "@expo/metro-runtime": "55.0.12",
    "@react-native-community/netinfo": "11.5.2",
    "@supabase/supabase-js": "2.112.3",
    "expo": "55.0.29",
    "expo-constants": "55.0.17",
    "expo-crypto": "55.0.18",
    "expo-dev-client": "55.0.38",
    "expo-font": "55.0.8",
    "expo-linking": "55.0.17",
    "expo-router": "55.0.18",
    "expo-secure-store": "55.0.17",
    "expo-splash-screen": "55.0.24",
    "expo-sqlite": "55.0.19",
    "expo-status-bar": "55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-web": "0.21.0"
  }
}
