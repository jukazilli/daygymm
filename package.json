{
  "name": "daygym",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": "22.12.0",
    "pnpm": "9.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:mobile": "turbo run build --filter=@daygym/mobile",
    "build:web": "turbo run build --filter=@daygym/web",
    "audit:dependencies": "tsx tooling/check-dependency-audit.ts",
    "check:boundaries": "tsx tooling/check-boundaries.ts",
    "check:secrets": "tsx tooling/check-secrets.ts",
    "check:ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:deploy:staging": "tsx tooling/deploy-staging-migrations.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint && eslint tooling eslint.config.mjs && pnpm check:boundaries",
    "security": "pnpm check:secrets && pnpm audit:dependencies",
    "supabase": "supabase",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc --project tooling/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.12.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "supabase": "2.114.0",
    "turbo": "2.10.9",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "4.1.10"
  }
}
