# Browser-safe Supabase values only. Leave empty until a remote environment is configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Expo public values only. Never place service-role, OAuth, SMTP or signing values here.
APP_VARIANT=development
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server and CI only. Never expose a database URL or password through NEXT_PUBLIC_ or EXPO_PUBLIC_.
SUPABASE_DB_URL_STAGING=
